# Copy to .env. The dashboard runs with the simulated source when this file
# is missing or left as-is. Nothing here dials a PBX.

# simulated | ami
DATA_SOURCE=simulated

HOST=0.0.0.0
PORT=8080
# IANA timezone for "today", the hourly chart, and the clock.
TIMEZONE=UTC
LOG_LEVEL=info

# Directory of the built React app. Leave empty to use web/dist when it exists.
WEB_DIST=

# Simulated floor. Seed only changes which callers are drawn, not the opening KPIs.
SIM_TICK_MS=1500
SIM_SEED=20261102

# Asterisk Manager (used when DATA_SOURCE=ami).
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=callboard
AMI_SECRET=
# Pause before the next TCP attempt after the socket drops.
AMI_RECONNECT_MS=5000
# Seconds the adapter holds an agent in wrap-up after AgentComplete.
# 0 releases them immediately, which matches queues.conf wrapuptime=0.
AMI_WRAPUP_SECONDS=0

# Per-queue service-level target. name:percent:thresholdSeconds
# Keys are Asterisk queue names (the simulated queues are sales, support, billing, vip).
QUEUE_SLA=sales:80:20,support:80:20,billing:90:15,vip:95:10

# Abandons shorter than this are left out of the service-level denominator.
SHORT_ABANDON_SECONDS=5
# Do not raise a service-level or abandon alert until a queue has this many offered calls.
SLA_MIN_OFFERED=15
# Abandon-rate alert, percent of offered.
MAX_ABANDON_PERCENT=8
# Longest-wait alert, seconds. Twice this value is raised as critical.
MAX_WAIT_SECONDS=60
